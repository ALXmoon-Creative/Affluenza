---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Visual Art — Affluenza"
  description="Explorations and personal projects."
>
  <main class="site-container">

    <section class="section-index">

      <header class="section-header">
        <h1>Visual Art</h1>
      </header>

      <div class="section-list">

        <article class="section-entry">
          <h2>
            <a class="text-link" href="/visual-art/compassio/">Compassio</a>
          </h2>
            <p>In memory of LittleMan.</p>
        </article>

        <article class="section-entry">
          <h2>
            <a class="text-link" href="/visual-art/right_here-right_now/">Right Here, Right Now</a>
          </h2>
            <p>Inspired by "The Tao of Pooh".</p>
        </article>

        <article class="section-entry">
          <h2>
            <a class="text-link" href="/visual-art/little_worms_nightmare/">A Little Worm's Nightmare</a>
          </h2>
            <p>A bit of comedy in a tough time.</p>
        </article>

      </div>

    </section>

  </main>
</BaseLayout>

<style>

  @media (max-width: 48rem) {
    .section-index {
      padding-top: 4rem;
    }

    .section-header {
      margin-bottom: 5rem;
    }

    .section-entry {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .section-image {
      justify-self: center;
    }

    .section-entry-text {
      max-width: none;
    }
  }
</style>