---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Reflections — Affluenza"
  description="Written explorations."
>
  <main class="site-container">

    <section class="section-index">

      <header class="section-header">
        <h1>Reflections</h1>
      </header>

      <div class="section-list">

        <article class="section-entry">
          <h2>
            <a class="text-link" href="/reflections/hospital_bed/">Hospital Bed</a>
          </h2>
            <p>Written - Summer 2025</p>
        </article>

        <article class="section-entry">
          <h2>
            <a class="text-link" href="/reflections/never_tomorrow/">Never Tomorrow</a>
          </h2>
            <p>Written - October 2024</p>
        </article>

        <article class="section-entry">
          <h2>
            <a class="text-link" href="/reflections/right-here-right-now/">Right Here, Right Now</a>
          </h2>
            <p>Written - May 2024</p>
        </article>

      </div>

    </section>

  </main>
</BaseLayout>

<style>
  @media (max-width: 48rem) {
    .section-index {
      padding-top: 4rem;
    }

    .section-header {
      margin-bottom: 5rem;
    }

    .section-entry {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .section-image {
      justify-self: center;
    }

    .section-entry-text {
      max-width: none;
    }
  }
</style>