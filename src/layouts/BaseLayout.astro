---
import "../styles/global.css";
import Header from "../components/header.astro";
import ExploreNav from "../components/ExploreNav.astro";
import Footer from "../components/footer.astro"

interface Props {
  title?: string;
  description?: string;
  exploreTitle?: string;
}

const {
  title = "Affluenza",
  description = "Art, photography, reflections, and personal discovery.",
  exploreTitle = "Where would you like to explore next?"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <link rel="stylesheet" href="https://use.typekit.net/jko0pqv.css">

    <title>{title}</title>
  </head>

  <body>
    <Header />
    <slot />

    <ExploreNav title={exploreTitle} />

    <Footer />
  </body>
</html>