---
import "../styles/global.css";
import Header from "../components/header.astro";
import ExploreNav from "../components/ExploreNav.astro";
import Footer from "../components/footer.astro"

import { ClientRouter } from "astro:transitions";

const pageFade = {
  forwards: {
    old: {
      name: "fadeOut",
      duration: "0.6s",
      easing: "cubic-bezier(0.4, 0, 0.2, 1)",
    },
    new: {
      name: "fadeIn",
      duration: "0.6s",
      easing: "cubic-bezier(0.4, 0, 0.2, 1)",
    },
  },
  backwards: {
    old: {
      name: "fadeOut",
      duration: "0.6s",
      easing: "cubic-bezier(0.4, 0, 0.2, 1)",
    },
    new: {
      name: "fadeIn",
      duration: "0.6s",
      easing: "cubic-bezier(0.4, 0, 0.2, 1)",
    },
  },
};

interface Props {
  title?: string;
  description?: string;
  exploreTitle?: string;
}

const {
  title = "Affluenza",
  description = "Art, photography, reflections, and personal discovery.",
  exploreTitle = "Where would you like to explore next?"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <ClientRouter />

    <link rel="stylesheet" href="https://use.typekit.net/jko0pqv.css">

    <title>{title}</title>
  </head>

  <body transition:animate={pageFade}>
    <Header />
    <slot />

    <ExploreNav title={exploreTitle} />

    <Footer />
  </body>
</html>

<style>
@keyframes fadeOut {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}  
</style>