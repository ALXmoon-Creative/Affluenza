---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Affluenza",
  description = "Art, photography, reflections, and personal discovery.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <link rel="stylesheet" href="https://use.typekit.net/jko0pqv.css">

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>